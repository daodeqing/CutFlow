{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "bash ../../scripts/prepare-linux-appimage.sh"
  },
  "bundle": {
    "targets": ["appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Bilibili media downloader",
    "linux": {
      "deb": {
        "depends": ["ffmpeg", "xdg-utils"],
        "recommends": ["gnome-keyring"],
        "section": "net"
      }
    }
  }
}
