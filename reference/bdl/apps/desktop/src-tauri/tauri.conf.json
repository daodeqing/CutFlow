{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CutFlow",
  "version": "0.4.0",
  "identifier": "com.daodeqing.cutflow",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CutFlow",
        "width": 1180,
        "height": 760,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
